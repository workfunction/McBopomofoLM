/* Window title suffix: version and build number */
"%@ (for version %@, r%@)" = "%1$@ (%2$@ 版，r%3$@)";

/* Buttons and the line under the license */
"Agree and Upgrade" = "同意並升級";
"Agree and Reinstall" = "同意並重新安裝";
"By upgrading the software I agree to the terms above." = "點選「同意並升級」，表示您同意本軟體的使用授權。";
"By reinstalling the software I agree to the terms above." = "點選「同意並重新安裝」，表示您同意本軟體的使用授權。";
"Cancel" = "取消";
"OK" = "好";
"Quit" = "結束";
"Replace" = "取代";
"Remove" = "移除";
"Keep" = "保留";
"Move to Trash" = "移到垃圾桶";
"Close Installer" = "關閉安裝程式";
"Finish" = "結束";
"Abort" = "放棄安裝";

/* Macs the input method cannot run on */
"This Mac cannot run McBopomofo LM" = "這台 Mac 無法使用小麥注音 LM";
"McBopomofo LM needs a Mac with Apple silicon (M1 or later). Intel Macs are not supported." = "小麥注音 LM 需要搭載 Apple 晶片（M1 或更新）的 Mac，不支援使用 Intel 處理器的 Mac。";
"McBopomofo LM needs macOS %d or later. This Mac runs macOS %@. Please update macOS first, then open the installer again." = "小麥注音 LM 需要 macOS %1$d 或以上版本，這台 Mac 目前是 macOS %2$@。請先更新 macOS，再重新打開安裝程式。";

/* A newer version is installed */
"A newer version is already installed" = "已經安裝了較新的版本";
"The installed McBopomofo LM is r%@, newer than the r%@ in this installer. Replace it with the older version?" = "目前安裝的小麥注音 LM 是 r%1$@，比這個安裝程式的 r%2$@ 還新。要換成較舊的版本嗎？";

/* Progress */
"Installing McBopomofo LM…" = "正在安裝小麥注音 LM…";
"Upgrading McBopomofo LM…" = "正在升級小麥注音 LM…";
"Step %1$d of %2$d: %3$@" = "第 %1$d 步（共 %2$d 步）：%3$@";
"Switching to the ABC keyboard…" = "正在切換到 ABC 鍵盤…";
"Moving the old version to the Trash…" = "正在把舊版移到垃圾桶…";
"Stopping the old version…" = "正在停止舊版…";
"Waiting for the old version to stop…" = "正在等待舊版完全停止…";
"Unpacking McBopomofo LM…" = "正在解開小麥注音 LM…";
"Copying to ~/Library/Input Methods…" = "正在拷貝到 ~/Library/Input Methods…";
"Removing the download mark…" = "正在移除「從網路下載」的標記…";
"Checking the installed files…" = "正在檢查安裝好的檔案…";
"Registering the input method and preparing its models…" = "正在登記輸入法並準備模型…";
"Turning on the Bopomofo input mode…" = "正在開啟注音輸入模式…";
"Preparing the models for the Neural Engine. The first time takes about 3 minutes; please keep this window open." = "正在為 Neural Engine 準備模型。第一次大約需要 3 分鐘，請不要關閉這個視窗。";
"Stopping the old version. This may take up to one minute…" = "等待舊版完全停用，大約需要一分鐘…";
"Please wait" = "請稍候";
"The installer is still working. Quitting now could leave McBopomofo LM half installed. Please wait until it finishes." = "安裝程式還在進行中。現在結束，小麥注音 LM 可能只裝到一半，請等它完成。";

/* Results */
"Installation Successful" = "安裝成功";
"McBopomofo is ready to use." = "小麥注音 LM 已經可以使用了。";
"If McBopomofo LM is not in the input menu, log out and log in again, or add it in System Settings > Keyboard > Input Sources." = "如果輸入選單裡找不到「小麥注音 LM」，請先登出再登入，或到「系統設定」>「鍵盤」>「輸入方式」加入。";
"Attention" = "請注意";
"McBopomofo is upgraded, but please log out or reboot for the new version to be fully functional." = "小麥注音 LM 升級完成，但建議您登出或重新啟動，以便順利使用新版。";
"Input method may not be fully enabled. Please enable it through System Preferences > Keyboard > Input Sources." = "輸入法已經安裝好，但可能沒有完全啟用。請到「系統設定」>「鍵盤」>「輸入方式」加入「小麥注音 LM」。";

/* Failures */
"Install Failed" = "安裝失敗";
"Fatal Error" = "安裝錯誤";
"No installable packagess found." = "找不到可安裝的輸入法套件。";
"Cannot activate the input method." = "無法啟用輸入法。";
"Cannot copy the file to the destination." = "無法將輸入法拷貝至目的地。";
"Cannot remove the existing version at %@, error: %@" = "無法移除既有版本，檔案位置: %1$@, 錯誤訊息: %2$@";
"Cannot unpack McBopomofo LM from the installer. Please download the installer again." = "無法從安裝程式中解開小麥注音 LM。請重新下載安裝程式。";
"The input method inside this installer does not match the installer's version. Please download the installer again." = "安裝程式裡的輸入法版本與安裝程式不一致。請重新下載安裝程式。";
"The download mark could not be removed from the installed files, so the input method would not start." = "無法移除安裝檔案上「從網路下載」的標記，輸入法將無法啟動。";
"McBopomofo LM was copied, but could not be registered as an input method." = "小麥注音 LM 已經拷貝完成，但無法登記為輸入法。";

/* Removal */
"Remove McBopomofo LM?" = "要移除小麥注音 LM 嗎？";
"This turns off the input method and moves McBopomofo LM from the Input Methods folder to the Trash. Your user phrases and settings stay where they are unless you choose otherwise in the next question." = "這會關閉輸入法，並把「小麥注音 LM」從 Input Methods 資料夾移到垃圾桶。您的使用者詞庫與設定預設會保留，下一個問題可以選擇是否一併刪除。";
"Removing McBopomofo LM…" = "正在移除小麥注音 LM…";
"Turning off the input method…" = "正在關閉輸入法…";
"Stopping McBopomofo LM…" = "正在停止小麥注音 LM…";
"Moving McBopomofo LM to the Trash…" = "正在把小麥注音 LM 移到垃圾桶…";
"Your user data" = "您的使用者資料";
"Input sources turned off: %d" = "已關閉的輸入方式：%d";
"Also delete your user data?" = "要一併刪除您的使用者資料嗎？";
"Your user phrases and settings are in %@. Keep them if you may install McBopomofo LM again." = "您的使用者詞庫與設定位於 %@。如果之後可能再安裝小麥注音 LM，建議保留。";
"McBopomofo LM Removed" = "已移除小麥注音 LM";
"McBopomofo LM has been moved to the Trash. If it still shows up in the input menu, please log out or restart your Mac." = "小麥注音 LM 已經移到垃圾桶。如果輸入選單裡仍然看得到，請登出或重新啟動 Mac。";
"Your user phrases and settings were kept in %@." = "您的使用者詞庫與設定仍保留在 %@。";
"Remove Failed" = "移除失敗";
"Cannot move %@ to the Trash, error: %@" = "無法把 %1$@ 移到垃圾桶，錯誤訊息：%2$@";

/* v3.3e fixes: partial failures, warnings, removal without the app, localized details */
"%d item(s) still carry the mark, for example: %@" = "還有 %1$d 個項目帶著標記，例如：%2$@";
"Another McBopomofo LM mode is still turned on. Turn it off in System Settings > Keyboard > Input Sources if you do not want it." = "小麥注音 LM 的其他輸入模式（例如純注音）仍然開啟。如果不需要，請到「系統設定」>「鍵盤」>「輸入方式」關閉。";
"Both models run on the Neural Engine." = "兩個模型都在 Neural Engine 上執行。";
"Decoder model ready (%d s)." = "解碼器模型準備好了（%d 秒）。";
"Encoder model ready (%d s)." = "編碼器模型準備好了（%d 秒）。";
"Exit status: %d" = "結束狀態碼：%d";
"Folder: %@" = "位置：%@";
"Installed, with a warning" = "安裝完成，但有提醒";
"McBopomofo LM has been turned off. If it still shows up in the input menu, please log out or restart your Mac." = "小麥注音 LM 已經關閉。如果輸入選單裡仍然看得到，請登出或重新啟動 Mac。";
"McBopomofo LM is the input method in use and the installer could not switch away from it. Please choose another input method (for example ABC) in the input menu, then open the installer again. Nothing was changed." = "目前正在使用小麥注音 LM，安裝程式無法切換到其他輸入法。請先在輸入選單改選其他輸入法（例如 ABC），再重新打開安裝程式。目前沒有更動任何東西。";
"Not every model can run on the Neural Engine of this Mac. McBopomofo LM works, but without the models that cannot run there (without the encoder it behaves like McBopomofo; without the decoder it uses the encoder only). It tries again every time it starts." = "這台 Mac 的 Neural Engine 無法執行所有模型。小麥注音 LM 仍然可以使用，但缺少無法執行的模型（沒有編碼器時，行為會接近原版小麥注音；沒有解碼器時，只用編碼器）。每次啟動時，輸入法都會再試一次。";
"Preparing the decoder model…" = "正在準備解碼器模型…";
"Preparing the encoder model…" = "正在準備編碼器模型…";
"Setting the old version aside…" = "正在暫時移開舊版…";
"Some input sources of McBopomofo LM could not be turned off. Turn them off in System Settings > Keyboard > Input Sources, then open the installer again. Nothing else was changed." = "小麥注音 LM 的部分輸入方式無法在這裡關閉。請到「系統設定」>「鍵盤」>「輸入方式」關閉，再重新打開安裝程式。其餘部分沒有更動。";
"The McBopomofo LM app is gone, but the input method is still registered or running. This turns it off. Your user phrases and settings stay where they are unless you choose otherwise in the next question." = "小麥注音 LM 的程式已經不在了，但輸入法仍然登記在系統裡或還在執行。這會把它關閉。您的使用者詞庫與設定預設會保留，下一個問題可以選擇是否一併刪除。";
"The compile cache of the models was cleared; they are prepared from scratch." = "模型的編譯快取已清除，將重新準備。";
"The input method inside this installer contains a link that points outside of it, so nothing was installed. Please download the installer again." = "這個安裝程式裡的輸入法含有指向外部的連結，所以沒有安裝任何東西。請重新下載安裝程式。";
"The input method inside this installer is missing or does not belong to it, so nothing can be installed. Please download the installer again." = "這個安裝程式裡缺少輸入法，或輸入法與安裝程式不相符，因此無法安裝。請重新下載安裝程式。";
"The installed files could not be checked completely, so the installer cannot tell whether the input method would start." = "無法完整檢查安裝好的檔案，安裝程式無法確定輸入法能否啟動。";
"The installed version could not be moved aside, so nothing was changed." = "無法暫時移開已安裝的版本，所以沒有更動任何東西。";
"The models are ready (%d s)." = "模型都準備好了（%d 秒）。";
"The previous version could not be put back automatically. You can find it here and move it back to ~/Library/Input Methods:" = "無法自動放回先前的版本。它在下面這個位置，請自行把它移回 ~/Library/Input Methods：";
"The previous version was put back." = "已把先前的版本放回原處。";
"This installer is incomplete" = "這個安裝程式不完整";
"Version found: %@, expected: %@" = "找到的版本：%1$@，預期的版本：%2$@";
"Version found: r%@, expected: r%@" = "找到的版本：r%1$@，預期的版本：r%2$@";
"Warning: not every model can run on the Neural Engine." = "提醒：並非所有模型都能在 Neural Engine 上執行。";
