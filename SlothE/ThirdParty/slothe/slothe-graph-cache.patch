+void slothe_graph_cache_stats(const slothe_model * m, int * n_graphs, size_t * compute_bytes, uint64_t * builds) {
+    size_t bytes = 0;
+    for (const auto & e : m->graphs) bytes += ggml_gallocr_get_buffer_size(e.galloc, 0);
+    if (n_graphs) *n_graphs = (int) m->graphs.size();
+    if (compute_bytes) *compute_bytes = bytes;
+    if (builds) *builds = m->graph_builds;
+}
