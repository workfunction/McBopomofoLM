+void slothe_set_graph_cache_capacity(slothe_model * m, int capacity) {
+    m->graph_capacity = capacity < 1 ? 1 : capacity;
+    while ((int) m->graphs.size() > m->graph_capacity) {
+        auto lru = std::min_element(m->graphs.begin(), m->graphs.end(),
+            [](const slothe_model::graph_entry & a, const slothe_model::graph_entry & b) { return a.last_use < b.last_use; });
+        slothe_free_graph(*lru);
+        m->graphs.erase(lru);
+    }
+}
