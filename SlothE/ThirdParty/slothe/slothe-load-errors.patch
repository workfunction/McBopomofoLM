+// McBopomofoLM patch 2: shape check for every weight the forward graph reads, so a malformed
+// (but parseable) GGUF is rejected here instead of tripping a GGML_ASSERT (abort) in a ggml op.
+static bool slothe_check_shapes(const slothe_model & m, std::string * why) {
+    const auto & hp = m.hp;
+    auto want = [&](const std::string & name, int64_t ne0, int64_t ne1) {
+        auto it = m.tensors.find(name);
+        if (it == m.tensors.end()) { *why = "missing tensor " + name; return false; }
+        const ggml_tensor * t = it->second;
+        if (t->ne[0] != ne0 || t->ne[1] != ne1 || t->ne[2] != 1 || t->ne[3] != 1) {
+            *why = "bad shape for " + name;
+            return false;
+        }
+        return true;
+    };
+    const int64_t hd = hp.head_dim;
+    const int64_t padd = ((hp.dim + hp.pad_to - 1) / hp.pad_to) * hp.pad_to;
+    const int64_t padf = ((hp.ffn + hp.pad_to - 1) / hp.pad_to) * hp.pad_to;
+    if (!want("token_embd.weight", hp.dim, hp.n_syl)) return false;
+    if (!want("token_embd_norm.weight", hp.dim, 1)) return false;
+    if (!want("output_norm.weight", hp.dim, 1)) return false;
+    if (!want("output.weight", hp.dim, hp.n_char)) return false;
+    char buf[128];
+    for (int il = 0; il < hp.n_layer; ++il) {
+        const bool is_fp = (il == 0) || (il == hp.n_layer - 1);
+        struct lin { const char * name; int64_t in; int64_t pad; int64_t out; };
+        const lin lins[] = {
+            { "attn_q", hp.dim, padd, hp.n_head * hd },
+            { "attn_k", hp.dim, padd, hp.n_head_kv * hd },
+            { "attn_v", hp.dim, padd, hp.n_head_kv * hd },
+            { "attn_output", hp.dim, padd, hp.dim },
+            { "ffn_gate", hp.dim, padd, hp.ffn },
+            { "ffn_up", hp.dim, padd, hp.ffn },
+            { "ffn_down", hp.ffn, padf, hp.dim },
+        };
+        for (const lin & l : lins) {
+            snprintf(buf, sizeof(buf), "blk.%d.%s.weight", il, l.name);
+            // slothe_lin: fp blocks multiply the raw weight, ternary blocks pad to `pad` first
+            // (only when pad > in, as in slothe_lin).
+            const int64_t in = is_fp ? l.in : (l.pad > l.in ? l.pad : l.in);
+            if (!want(buf, in, l.out)) return false;
+            if (!is_fp) {
+                snprintf(buf, sizeof(buf), "blk.%d.%s_subln.weight", il, l.name);
+                if (!want(buf, l.in, 1)) return false;
+            }
+        }
+        snprintf(buf, sizeof(buf), "blk.%d.attn_norm.weight", il);
+        if (!want(buf, hp.dim, 1)) return false;
+        snprintf(buf, sizeof(buf), "blk.%d.ffn_norm.weight", il);
+        if (!want(buf, hp.dim, 1)) return false;
+        snprintf(buf, sizeof(buf), "blk.%d.attn_q_rmsnorm.weight", il);
+        if (!want(buf, hd, 1)) return false;
+        snprintf(buf, sizeof(buf), "blk.%d.attn_k_rmsnorm.weight", il);
+        if (!want(buf, hd, 1)) return false;
+    }
+    return true;
+}
